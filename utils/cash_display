-- cash display stuff for jailbrek

local ScreenGui = Instance.new("ScreenGui")
local CashFrame = Instance.new("Frame")
local CashLabel = Instance.new("TextLabel")

ScreenGui.Parent = game.CoreGui
ScreenGui.Name = "CashDisplay"

CashFrame.Parent = ScreenGui
CashFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
CashFrame.BackgroundTransparency = 0.3
CashFrame.BorderSizePixel = 0
CashFrame.Position = UDim2.new(0, 10, 0.53, 0)
CashFrame.Size = UDim2.new(0, 170, 0, 30)
CashFrame.Active = true

CashLabel.Parent = CashFrame
CashLabel.BackgroundTransparency = 1
CashLabel.Position = UDim2.new(0, 0, 0, 0)
CashLabel.Size = UDim2.new(1, 0, 1, 0)
CashLabel.Font = Enum.Font.GothamBold
CashLabel.Text = "Loading"
CashLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
CashLabel.TextScaled = true
CashLabel.TextStrokeTransparency = 0
CashLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

local function format(number)
    return string.format("%d", number):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

while task.wait(0.1) do
    local success, error = pcall(function()
        CashLabel.Text = "$" .. format(game:GetService("Players").LocalPlayer.leaderstats.Money.Value)
    end)
end