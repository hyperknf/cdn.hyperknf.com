-- **3 MINUTE SCREEN TIMER GUI**
local ScreenGui = Instance.new("ScreenGui")
local TimerFrame = Instance.new("Frame")
local TimerLabel = Instance.new("TextLabel")

ScreenGui.Parent = game.CoreGui
ScreenGui.Name = "ServerHopTimer"

TimerFrame.Parent = ScreenGui
TimerFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
TimerFrame.BackgroundTransparency = 0.3
TimerFrame.BorderSizePixel = 0
TimerFrame.Position = UDim2.new(0, 10, 0.65, 0)
TimerFrame.Size = UDim2.new(0, 100, 0, 50)
TimerFrame.Active = true

TimerLabel.Parent = TimerFrame
TimerLabel.BackgroundTransparency = 1
TimerLabel.Position = UDim2.new(0, 0, 0, 0)
TimerLabel.Size = UDim2.new(1, 0, 1, 0)
TimerLabel.Font = Enum.Font.GothamBold
TimerLabel.Text = "5:00"
TimerLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
TimerLabel.TextScaled = true
TimerLabel.TextStrokeTransparency = 0
TimerLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

-- Countdown loop (3 minutes = 180 seconds)
for i = 300, 0, -1 do
    local minutes = math.floor(i / 60)
    local seconds = i % 60
    TimerLabel.Text = string.format("%d:%02d", minutes, seconds)
    task.wait(1)
end

TimerLabel.Text = "HOPPING!"
TimerLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
task.wait(1)
ScreenGui:Destroy()

-- **DELTA COMPATIBLE SERVER HOP**
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local PlaceId = 606849621  -- Jailbreak

repeat task.wait() until game:IsLoaded() and Players.LocalPlayer
local lp = Players.LocalPlayer

-- Get servers using HttpService (Delta compatible)
local servers = {}
local cursor = ""
repeat
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")))
    end)
    
    if success and result and result.data then
        for _, server in pairs(result.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                table.insert(servers, server.id)
            end
        end
        cursor = result.nextPageCursor or ""
    end
    task.wait()
until #servers > 0 or cursor == ""

-- Hop to first available server
if #servers > 0 then
    local randomServer = servers[math.random(1, #servers)]
    TeleportService:TeleportToPlaceInstance(PlaceId, randomServer, lp)
else
    TeleportService:Teleport(PlaceId)  -- Fallback
end 